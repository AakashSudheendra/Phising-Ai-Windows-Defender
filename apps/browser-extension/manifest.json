{
  "manifest_version": 3,
  "name": "PhishGuard — Real-Time Anti-Phishing Protection",
  "version": "1.0.0",
  "description": "Real-time pre-navigation phishing detection and blocking powered by PhishGuard Enterprise Security.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PhishGuard Real-Time Protection",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "webNavigation",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:8766/*",
    "http://localhost:8766/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pages/interstitial.html",
        "pages/interstitial.css",
        "pages/interstitial.js",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
